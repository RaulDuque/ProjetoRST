{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "disableBypassPermissionsMode": "disable",
    "allow": [
      "Bash(cargo fmt --check *)",
      "Bash(cargo clippy *)",
      "Bash(cargo test *)",
      "Bash(cargo check *)",
      "Bash(cargo build *)",
      "Bash(cargo run *)",
      "Bash(cargo tree *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)"
    ],
    "ask": [
      "Bash(cargo * --release*)",
      "Bash(cargo * --profile*)",
      "Bash(git push *)",
      "Bash(git commit --amend*)"
    ],
    "deny": [
      "Edit(/Md-usario/**)",
      "Edit(/saves/**)",
      "Bash(rm -r*)",
      "Bash(rm -R*)",
      "Bash(rm -fr*)",
      "Bash(rm -fR*)",
      "Bash(rm --recursive*)",
      "Bash(find * -delete*)",
      "Bash(git reset --hard*)",
      "Bash(git reset * --hard*)",
      "Bash(git clean *)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git push * +*)",
      "Bash(git checkout -- *)",
      "Bash(git checkout .)",
      "Bash(git stash drop*)",
      "Bash(git stash clear*)",
      "Bash(git branch -D *)",
      "Bash(git worktree add *)",
      "Bash(git rebase *)",
      "Bash(git * --output*)",
      "Bash(cargo clean*)",
      "Bash(cargo * --target-dir*)",
      "Bash(cargo run --example autoplay*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -B \"${CLAUDE_PROJECT_DIR}/.claude/hooks/guard.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
