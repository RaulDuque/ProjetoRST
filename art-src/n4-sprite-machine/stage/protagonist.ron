// N4-A sprite machine: the N3.5 protagonist as independent layers (isolated
// proof; NOT the production art, NOT read by `cargo run`).
//
// Every layer PNG has the original 80x128 canvas and the (40, 118) pivot.
// The visible texels of the layers are a partition of the approved idle
// (recomposed texel for texel by tests/n4_sprite_machine_tests.rs); the
// anatomy hidden under the hair and the clothes is an artistic
// interpretation by the agent, pending the owner's evaluation.
// Built by art-src/n4-sprite-machine/scripts/build_idle_layers.py.
// Format: src/player/visual/composition.rs, docs/development/n4/N4A_CONTRATO_DADOS.md.
(
    version: 1,
    id: "protagonist_n4a",
    clips: {
        "idle": (cell: (80, 128), pivot: (40.0, 118.0), density: 2, frames: 1),
        // Prepared, not built in N4-A: the run uses 112x128, pivot (56, 118),
        // 6 frames. Its sheets will be added per part in a later phase.
    },
    // Back to front (the index is the z).
    layers: ["body", "trousers", "boots", "arm_front", "shirt", "bracers", "hair_back", "hair_front"],
    parts: {
        // Neutral anatomical body: torso, head, legs and feet behind the
        // clothes, and the front arm, which hangs in front of the trousers
        // and under the sleeve.
        "body": (region: Body, removable: false, pieces: [
            (layer: "body", sheets: { "idle": (texture: "parts/idle/body.png") }),
            (layer: "arm_front", sheets: { "idle": (texture: "parts/idle/arm_front.png") }),
        ]),
        "hair": (region: HairBack, pieces: [
            (layer: "hair_back", sheets: { "idle": (texture: "parts/idle/hair_back.png") }),
            (layer: "hair_front", sheets: { "idle": (texture: "parts/idle/hair_front.png") }),
        ]),
        "shirt": (region: Shirt, pieces: [
            (layer: "shirt", sheets: { "idle": (texture: "parts/idle/shirt.png") }),
        ]),
        "trousers": (region: Trousers, pieces: [
            (layer: "trousers", sheets: { "idle": (texture: "parts/idle/trousers.png") }),
        ]),
        "boots": (region: Boots, pieces: [
            (layer: "boots", sheets: { "idle": (texture: "parts/idle/boots.png") }),
        ]),
        "bracers": (region: Bracers, pieces: [
            (layer: "bracers", sheets: { "idle": (texture: "parts/idle/bracers.png") }),
        ]),
    },
    default_outfit: ["hair", "shirt", "trousers", "boots", "bracers"],
)
