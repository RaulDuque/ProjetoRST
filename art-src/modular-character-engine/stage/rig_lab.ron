                // 1 (video 50): measured on the video frame.
                { pelvis: (58, 62), neck: (63.5, 33), head: (66, 25),
                  shoulder_near: (61, 38), elbow_near: (67, 50), hand_near: (80, 40),
                  shoulder_far: (57, 38), elbow_far: (47, 46), hand_far: (49, 56),
