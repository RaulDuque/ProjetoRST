// N3.8 experimental protagonist (NOT the production art): the approved N3.5
// standing pose as idle and the approved N3.6 run (video frames 48, 50, 52,
// 54, 56, 58) at a fixed 15 fps. Both PNGs are byte-identical copies of
// art-src/n3-5-fidelity/generated/candidate_106.png and
// art-src/n3-6-animation-proof/generated/run6.png (checked by
// tests/n3_8_production_run_tests.rs).
//
// Every other state has no approved clip: the runtime holds the idle pose
// (tinted for hurt, guard, cast and death) and the experimental badge names
// the missing clip. No socket table: the held weapon and shield layers stay
// off in this mode. Read with DARK_CASTLE_PROTAGONIST=n3 cargo run.
// Docs: docs/development/n3_8/N3_8_CORRIDA_PRODUCAO.md.
(
    version: 1,
    facing: Right,
    weapon_in_body: false,
    atlases: {
        "n35_idle": (texture: "sprites/player/n35_idle.png", cell: (80, 128), columns: 1, rows: 1, padding: 0, density: 2),
        "n36_run": (texture: "sprites/player/n36_run6.png", cell: (112, 128), columns: 6, rows: 1, padding: 0, density: 2),
    },
    clips: {
        "idle": (atlas: "n35_idle", first: 0, count: 1, mode: Loop(fps: 1.0),
            pivot: (40.0, 118.0), fallback: None,
            durations: [1.0], speed_reference: None),
        // 6 frames x 1/15 s = 0.4 s per cycle. No speed_reference: the rate
        // never follows the speed, so the run never plays above 15 fps.
        "run": (atlas: "n36_run", first: 0, count: 6, mode: Loop(fps: 15.0),
            pivot: (56.0, 118.0), fallback: Some("idle"),
            durations: [0.06666667, 0.06666667, 0.06666667, 0.06666667, 0.06666667, 0.06666667],
            speed_reference: None),
    },
)
