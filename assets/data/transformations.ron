// Transformations (V1.9). Format: src/transform/definitions.rs;
// design and values: docs/TRANSFORMATIONS_V1_9.md. Values are provisional
// and original. The human form is not listed: it is the absence of a form
// and keeps the global movement constants of src/core/constants.rs.
[
    (
        id: Spectral,
        name: "Spectral Form",
        description: "The body thins into a grey veil that drifts through spectral barriers.",
        // Same ability the Relic of the Veil grants (and the world's
        // `passages` name for Spectral veils).
        unlock: Ability(VeilStep),
        unlock_hint: "Relic of the Veil",
        // Starting MP is 52 (regen 0.8/s): about 13 s of form from full.
        costs: (activation_mp: 8, mp_per_second: 4.0),
        movement: (
            // Slower than walking (190); no run, no jump.
            speed: 150.0,
            // Drifts down instead of falling (human: 1.0, cap -900).
            gravity_scale: 0.35,
            max_fall_speed: -220.0,
        ),
        collision: (passes: [Spectral]),
        allowed: [Move],
        activation: (grounded_only: true),
        cancel: (voluntary: true, on_mp_empty: true),
        visual: (
            tint: (0.62, 0.86, 1.0),
            alpha: 0.55,
            outline: (0.75, 0.95, 1.0),
            outline_alpha: 0.5,
            mote_interval: 0.09,
            low_mp_seconds: 3.0,
        ),
        on_load: HumanForm,
    ),
]
