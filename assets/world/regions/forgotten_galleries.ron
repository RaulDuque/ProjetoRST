        ),
        (
            id: "fg_lever_hall",
            name: "Lever Hall",
            region: "forgotten_galleries",
            role: Required,
            map: (x: -3, y: 1, w: 1, h: 1),
            background: (0.06, 0.07, 0.07),
            platforms: [
                (min: (300.0, 130.0), size: (240.0, 16.0), one_way: true),
            ],
            objects: [
                // On the ledge: reached by jumping, not from the floor.
                (id: "fg_hall_lever", kind: Lever(sets: "fg_hall_gate_open"),
                    area: (min: (400.0, 146.0), size: (16.0, 40.0))),
            ],
            doors: [
                (id: "to_upper_gallery", side: Left, to: (room: "fg_upper_gallery", door: "to_lever_hall")),
                (id: "to_astral_gate", side: Right, to: (room: "fg_astral_gate", door: "to_lever_hall"),
