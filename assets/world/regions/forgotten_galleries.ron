        ),
        (
            id: "fg_astral_gate",
            name: "Astral Gate",
            region: "forgotten_galleries",
            role: Required,
            map: (x: -2, y: 1, w: 1, h: 1),
            background: (0.05, 0.05, 0.10),
            enemies: [
                (enemy: "bone_sentry", position: (700.0, 70.0), patrol_half_width: 200.0),
            ],
            doors: [
                (id: "to_lever_hall", side: Left, to: (room: "fg_lever_hall", door: "to_astral_gate"),
