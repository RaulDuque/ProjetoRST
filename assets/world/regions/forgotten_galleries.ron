// Region "Forgotten Galleries" (Galerias Esquecidas), V1.8. Original content.
// Provisional geometry, built for the real physics (jump ~136 u, every
// climb step rises <= 110 u). Docs: docs/WORLD_EXPLORATION_V1_8.md.
//
//   y=2  [stair]  [relic chapel]<->[collapsed walk]<~>[hidden oratory]
//   y=1  [stair]  [ upper gallery (2) ]<->[lever hall]=>[astral gate]=>[return bridge]
//   y=0  [cache]<~[stair]<->[ long gallery (2) ]<->[threshold]<->(Vigil reliquary)
//                                                                  return bridge drops into
//                                                                  the Vigil sealed hall (shortcut)
//   <~> secret (breakable wall at the stair, hidden switch in the collapsed walk)
//   =>  special doors: lever gate (lever hall), astral seal (Astral Emblem)
//   The collapsed walk drops into the upper gallery: a loop
//   stair -> chapel -> walk -> upper gallery -> stair.
(
    region: (id: "forgotten_galleries", name: "Forgotten Galleries", color: (0.36, 0.52, 0.5),
        // V2.3 look (src/world/scenery.rs; docs/WORLD_VISUAL_V2_3.md §5).
        visual: Some((backdrop: Ruins, stone: (0.3, 0.34, 0.32), light: (0.55, 0.9, 0.78),
            sky: (0.03, 0.07, 0.07), fog: Some((color: (0.4, 0.55, 0.5), density: 0.22))))),
    rooms: [
        (
            id: "fg_threshold",
            name: "Gallery Threshold",
            region: "forgotten_galleries",
            role: Required,
            map: (x: -3, y: 0, w: 1, h: 1),
            background: (0.05, 0.08, 0.08),
            platforms: [
                (min: (560.0, 40.0), size: (120.0, 50.0)),
            ],
            doors: [
                (id: "to_reliquary", side: Right, to: (room: "vigil_gates_reliquary", door: "to_galleries"),
                    requires: Some(Flag("vigil_gates_cleared"))),
                (id: "to_long_gallery", side: Left, to: (room: "fg_long_gallery", door: "to_threshold")),
            ],
        ),
        (
            id: "fg_long_gallery",
            name: "Long Gallery",
            region: "forgotten_galleries",
            role: Required,
            map: (x: -5, y: 0, w: 2, h: 1),
            background: (0.05, 0.07, 0.08),
            platforms: [
                (min: (900.0, 40.0), size: (100.0, 70.0)),
                (min: (1200.0, 190.0), size: (260.0, 16.0), one_way: true),
            ],
            enemies: [
                (enemy: "bone_sentry", position: (1500.0, 70.0), patrol_half_width: 220.0),
            ],
            objects: [
                (id: "fg_gallery_chest", kind: Chest(tier: Common, reward: Item("minor_tonic")),
                    area: (min: (2200.0, 40.0), size: (48.0, 36.0))),
            ],
            doors: [
                (id: "to_threshold", side: Right, to: (room: "fg_threshold", door: "to_long_gallery")),
                (id: "to_stair", side: Left, to: (room: "fg_stair", door: "to_long_gallery")),
            ],
        ),
        (
            id: "fg_stair",
            name: "Hollow Stair",
            region: "forgotten_galleries",
            role: Required,
            map: (x: -6, y: 0, w: 1, h: 3),
            background: (0.04, 0.06, 0.07),
            platforms: [
                // To the upper gallery (ledge of the right door, cell 1, top 760).
                (min: (260.0, 130.0), size: (240.0, 16.0), one_way: true),
                (min: (360.0, 240.0), size: (240.0, 16.0), one_way: true),
                (min: (460.0, 350.0), size: (240.0, 16.0), one_way: true),
                (min: (560.0, 460.0), size: (240.0, 16.0), one_way: true),
                (min: (660.0, 570.0), size: (240.0, 16.0), one_way: true),
                (min: (760.0, 680.0), size: (240.0, 16.0), one_way: true),
                // To the relic chapel (ledge of the right door, cell 2, top 1480).
                (min: (860.0, 850.0), size: (240.0, 16.0), one_way: true),
                (min: (760.0, 960.0), size: (240.0, 16.0), one_way: true),
                (min: (660.0, 1070.0), size: (240.0, 16.0), one_way: true),
                (min: (760.0, 1180.0), size: (240.0, 16.0), one_way: true),
                (min: (860.0, 1290.0), size: (240.0, 16.0), one_way: true),
                (min: (760.0, 1400.0), size: (240.0, 16.0), one_way: true),
            ],
            objects: [
                // Cracked masonry over the left door: any attack breaks it.
                (id: "fg_cracked_wall", kind: BreakableWall(breaks_on: AnyAttack),
                    area: (min: (0.0, 40.0), size: (80.0, 160.0))),
            ],
            // V2.3 decoration (drawn only, never collides).
            decor: [
                (kind: Pillar(height: 260.0), at: (180.0, 40.0)),
