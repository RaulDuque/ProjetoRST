                (id: "to_lever_hall", side: Right, to: (room: "fg_lever_hall", door: "to_upper_gallery")),
                // The collapsed walk drops in here (one way: the loop of the region).
                (id: "from_collapsed_walk", side: Top, cell: 1, to: (room: "fg_collapsed_walk", door: "to_upper_gallery"),
