                (kind: IronGrate(width: 90.0, height: 180.0), at: (190.0, 760.0)),
                (kind: Torch, at: (1180.0, 1020.0)),
                (kind: Arch(width: 200.0, height: 340.0), at: (360.0, 1560.0)),
                (kind: DeadVine(length: 220.0), at: (60.0, 2000.0)),
                (kind: DeadVine(length: 160.0), at: (1220.0, 1320.0)),
                (kind: Lantern, at: (560.0, 2100.0)),
                (kind: Chain(length: 260.0), at: (300.0, 2120.0), layer: Front),
                (kind: Chain(length: 200.0), at: (1150.0, 2120.0), layer: Front),
                (kind: DeadVine(length: 140.0), at: (1000.0, 2120.0), layer: Front),
            ],
            doors: [
                (id: "to_long_gallery", side: Right, to: (room: "fg_long_gallery", door: "to_stair")),
                (id: "to_cracked_cache", side: Left, to: (room: "fg_cracked_cache", door: "to_stair"),
                    hidden_by: Some("fg_cracked_wall")),
                (id: "to_upper_gallery", side: Right, cell: 1, to: (room: "fg_upper_gallery", door: "to_stair")),
                (id: "to_chapel", side: Right, cell: 2, to: (room: "fg_relic_chapel", door: "to_stair")),
            ],
        ),
        (
            id: "fg_cracked_cache",
            name: "Cracked Cache",
            region: "forgotten_galleries",
            role: Secret,
            map: (x: -7, y: 0, w: 1, h: 1),
            background: (0.09, 0.08, 0.05),
            objects: [
                (id: "fg_cache_chest", kind: Chest(tier: Secret, reward: Item("ashen_ring")),
